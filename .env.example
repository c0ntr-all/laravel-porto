# Host path to Windows F: (Music, Images, Video).
# From WSL/Linux Docker use /mnt/f. Do not use "F:" — Docker treats ":" as a volume separator.
# From Docker Desktop on Windows you can use //f instead.
WINDOWS_F_MOUNT=/mnt/f

# Frontend (Quasar dev server behind nginx)
QUASAR_API_URL=/api
QUASAR_PUBLIC_HOST=docker-porto.loc
QUASAR_HMR_CLIENT_PORT=80
QUASAR_REVERB_HOST=docker-porto.loc
QUASAR_REVERB_PORT=80
QUASAR_REVERB_SCHEME=http
QUASAR_REVERB_KEY=fxtmwduaoktnho1q7s1n
