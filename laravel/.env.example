APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_ALLOWED_ORIGINS=http://docker-porto.loc
APP_URL=http://host.docker.internal
API_URL=http://host.docker.internal/api
#APP_URL=http://docker-porto.loc
#API_URL=http://docker-porto.loc
API_PREFIX=api
AUTH_GUARD=api
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

GLOBAL_API_RATE_LIMIT_ENABLED=true
GLOBAL_API_RATE_LIMIT_ATTEMPTS_PER_MIN=30
GLOBAL_API_RATE_LIMIT_EXPIRES_IN_MIN=1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql-db
DB_PORT=3306
DB_DATABASE=home_portal_v2
DB_USERNAME=root
DB_PASSWORD=root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Docker/Linux: leave empty (storage/mnt/f). OSPanel/Windows PHP: leave empty (F:\).
# Override only if the library is not on F:\ — this must be the drive root, not F:\Music.
# WINDOWS_F_DISK_ROOT=F:\
MUSIC_LIBRARY_DRIVE=F
MUSIC_LIBRARY_ROOT_PATH="F:\Music"

# Windows folders for the computer library. Set these per machine.
WINDOWS_IMAGES_ROOT_FOLDER="F:\Images\\"
WINDOWS_VIDEOS_ROOT_FOLDER="F:\Videos\\"

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe

KINOPOISK_DEV_API_KEY=
KINOPOISK_DEV_API_URL=https://api.poiskkino.dev
KINOPOISK_DEV_TIMEOUT=30
KINOPOISK_DEV_CONNECT_TIMEOUT=15
KINOPOISK_DEV_RETRIES=3

STEAM_WEB_API_KEY=
STEAM_WEB_API_URL=https://api.steampowered.com
STEAM_WEB_API_LANGUAGE=russian
STEAM_WEB_API_TIMEOUT=30
STEAM_WEB_API_CONNECT_TIMEOUT=15
STEAM_WEB_API_RETRIES=2

STEAM_STORE_URL=https://store.steampowered.com
STEAM_STORE_LOCALE=english
STEAM_STORE_TIMEOUT=30
STEAM_STORE_CONNECT_TIMEOUT=15
STEAM_STORE_RETRIES=2
